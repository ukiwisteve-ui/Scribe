# Copy this file to .env (setup.ps1 does it for you) and fill in your keys.

# Transcription: https://console.deepgram.com (free credit on sign-up)
DEEPGRAM_API_KEY=

# Summaries: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Your name, used for your microphone in transcripts and for your action items.
SCRIBE_USER_NAME=Steve

# Names and jargon Deepgram should spell correctly, separated by commas.
# Names typed in "Who's on the call?" are added automatically.
# SCRIBE_VOCABULARY=Siobhan, Acme, Kubernetes, OKRs

# Spoken language code, e.g. en, en-GB, de, fr. Use "multi" for mixed-language calls.
SCRIBE_LANGUAGE=en

# Where sessions are saved. Defaults to Documents\Scribe.
# SCRIBE_OUTPUT_DIR=C:\Users\you\Documents\Scribe

# Claude model for summaries.
# SCRIBE_CLAUDE_MODEL=claude-opus-5-5

# Keep the original per-device WAV files after processing (they are large).
# SCRIBE_KEEP_RAW_AUDIO=false
